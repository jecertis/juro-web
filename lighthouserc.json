{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/checklist.html",
        "http://localhost/install.html",
        "http://localhost/about.html",
        "http://localhost/directory.html",
        "http://localhost/partners.html",
        "http://localhost/which-juro.html",
        "http://localhost/dora-soc2-gap.html",
        "http://localhost/dpdp-data-flow-mapper.html",
        "http://localhost/dpdp-technical-evidence-handbook.html",
        "http://localhost/privacy.html",
        "http://localhost/deploy-evergent.html",
        "http://localhost/blog/index.html",
        "http://localhost/blog/dpdp-rules-2025-explained.html",
        "http://localhost/blog/dpdp-phase-ii-consent-managers.html",
        "http://localhost/blog/cert-in-audit-evidence.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": [
          "uses-http2",
          "is-on-https",
          "redirects-http",
          "uses-long-cache-ttl",
          "canonical"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "speed-index": ["error", { "minScore": 0.90 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.90 }],
        "categories:seo": ["warn", { "minScore": 0.95 }],
        "color-contrast": "error",
        "document-title": "error",
        "html-has-lang": "error",
        "meta-description": "warn",
        "viewport": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
